APP_NAME="Market Signal System"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/market-system/public
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_KEY=change_this_to_a_64_char_hex_secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=market_signal
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

ADMIN_NAME="Private Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="ChangeMe123!Strong"

COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Lax
SESSION_NAME=market_signal_session

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Legacy single-market (kept for backward compat, not used by scanner)
MARKET_SYMBOL=EURUSD=X
MARKET_LABEL="EUR/USD"

# Active market timeframe and limits
MARKET_TIMEFRAME=60m
MAX_SIGNALS_PER_DAY=2
MAX_SIGNALS_FRIDAY=1
MIN_CONFIDENCE_TO_ALERT=65

# Multi-market configuration
MARKETS=EURUSD=X,GBPUSD=X,USDJPY=X
MARKET_EURUSD_LABEL="EUR/USD"
MARKET_GBPUSD_LABEL="GBP/USD"
MARKET_USDJPY_LABEL="USD/JPY"

# Market Data Layer (Phase 2.2A) — Deriv (live) -> Yahoo Finance (fallback) -> cache
MARKET_DATA_PRIMARY_PROVIDER=deriv
MARKET_DATA_FALLBACK_PROVIDER=yahoo_finance

# 1089 is Deriv's own published public demo app_id (api.deriv.com) — register
# your own at https://developers.deriv.com for production use. Market data
# (candles/ticks) needs no API token; leave DERIV_API_TOKEN blank unless you
# want the wider rate-limit tier that comes with an authorized connection.
DERIV_APP_ID=1089
DERIV_API_TOKEN=
DERIV_WS_ENDPOINT=wss://ws.derivws.com/websockets/v3
DERIV_WS_TIMEOUT_SECONDS=10
DERIV_RETRY_ATTEMPTS=0

MARKET_DATA_CACHE_SECONDS=120
MARKET_DATA_CACHE_SECONDS_DAILY=21600
MARKET_DATA_CACHE_SECONDS_LONG=86400
MARKET_DATA_QUOTE_CACHE_SECONDS=45

# Pattern Recognition Library (Phase 2.9) — algorithmic chart-pattern
# detection consumed by the Scanner (signal reasons) and AI Vision
# (cross-check against the LLM's own screenshot read). A real, already-built
# capability, hence USE_* rather than FEATURE_* — kill switch only, no page.
USE_PATTERN_RECOGNITION=true

NEWS_PROVIDER=marketaux
MARKETAUX_API_KEY=your_marketaux_key_here
MARKETAUX_MAX_ARTICLES=6
MARKETAUX_SCAN_MINUTES=30

USE_ECONOMIC_CALENDAR=true
ECONOMIC_CALENDAR_PROVIDER=manual
HIGH_IMPACT_BLOCK_MINUTES_BEFORE=45
HIGH_IMPACT_BLOCK_MINUTES_AFTER=30

USE_RSS_FALLBACK=true
RSS_MAX_ARTICLES=8

NEWS_API_KEY=
NEWS_MAX_ARTICLES=10
USE_AI_SENTIMENT=false

USE_AI_SUMMARY=false
AI_PRIMARY_PROVIDER=claude
AI_FALLBACK_PROVIDER=openai
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_SUMMARY_CACHE_MINUTES=30
AI_MAX_HEADLINES=8
AI_MAX_TOKENS=350
AI_TEMPERATURE=0.2

MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=alerts@example.com
MAIL_PASSWORD=change_this
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=alerts@example.com
MAIL_FROM_NAME="Market Alerts"
ALERT_EMAIL_TO=your-email@example.com

MAIL_IMAP_HOST=smtp.example.com
MAIL_IMAP_PORT=993
MAIL_POP3_PORT=995

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN. TELEGRAM_ADMIN_CHAT_ID
# is the numeric chat id alerts are sent to (message the bot once, then read
# your chat id from https://api.telegram.org/bot<token>/getUpdates).
# TELEGRAM_WEBHOOK_SECRET is compared against Telegram's
# X-Telegram-Bot-Api-Secret-Token header on inbound webhook calls — generate a
# long random value, never reuse it elsewhere.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_COMMUNITY_LINK=
TELEGRAM_COMMUNITY_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_BOT_MODE=webhook
