{
  "name": "private/market-signal-system",
  "description": "Single-user PHP market signal system",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "vlucas/phpdotenv": "^5.6",
    "guzzlehttp/guzzle": "^7.9",
    "phpmailer/phpmailer": "^6.9",
    "textalk/websocket": "^1.5",
    "dompdf/dompdf": "^3.1",
    "phpoffice/phpspreadsheet": "^5.9"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "bootstrap/helpers.php"
    ]
  },
  "config": {
    "platform": {
      "php": "8.2.12"
    }
  }
}
