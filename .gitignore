# Environment files — never commit secrets
.env
.env.*
!.env.example

# Composer dependencies (install with composer install)
/vendor/

# Runtime data: cache, logs, uploads
/storage/cache/*
/storage/logs/*
/storage/uploads/*
!/storage/**/.htaccess

# Archives / OS / editor junk
*.zip
*.log
.claude/
Thumbs.db
.DS_Store
